# Google Places API (New) 키
# Google Cloud 콘솔 > API 및 서비스 > "Places API (New)" 사용 설정 > 사용자 인증 정보 > API 키 만들기
# 비워두면 데모 데이터로 실행됩니다.
GOOGLE_PLACES_API_KEY=

# 검색 1번에 Google 호출 횟수 (1: 인기순 20곳 / 2: 인기순+가까운순 최대 40곳)
# 무료 한도(월 1,000회)를 아끼려면 1
GOOGLE_CALLS_PER_SEARCH=1

# 카드를 펼칠 때 불러올 사진 수 (사진 1장 = Place Photos 1회, 월 1,000회 무료)
PHOTOS_PER_PLACE=4

# 같은 동네(약 100m 격자) 결과를 재사용하는 시간(분)
CACHE_MINUTES=360

# 웹 앱 주소(CORS). 비우면 모두 허용 — 배포 시 꼭 지정
# 예) CORS_ORIGINS=https://matjip.example.com,http://localhost:8081
CORS_ORIGINS=

PORT=3000
